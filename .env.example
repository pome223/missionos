# MissionOS environment template.
# Copy to `.env` and fill in values: cp .env.example .env

# Required only when MISSIONOS_LLM_BACKEND=gemini.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Use Google AI Studio (false) or Vertex AI (true). Leave false for the quickstart.
GOOGLE_GENAI_USE_VERTEXAI=false
# Required with Vertex AI. The supported gemini-3.1-flash-lite endpoint is
# global; MissionOS also normalizes stale regional defaults to this value.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# LLM backend.
#
# MissionOS is designed around an LLM-in-the-loop chat path. Set this to
# `gemini`, `deepseek`, or `ollama` for the intended MissionOS experience.
#
# `off` is a safe development fallback for boundary tests. It disables
# LLM-backed ADK paths in CLI-managed Gateway children and should not be treated
# as the main product experience.
# - gemini: Google ADK/Gemini (requires GOOGLE_API_KEY or Vertex credentials)
# - deepseek: hosted DeepSeek through ADK LiteLLM (requires DEEPSEEK_API_KEY)
# - ollama: local Ollama through ADK LiteLLM; no GOOGLE_API_KEY is propagated
# - off: development fallback only
MISSIONOS_LLM_BACKEND=off
AGENT_MODEL=gemini-3.1-flash-lite
DEEPSEEK_API_KEY=
MISSIONOS_DEEPSEEK_MODEL=deepseek-v4-flash
MISSIONOS_DEEPSEEK_API_BASE=https://api.deepseek.com
MISSIONOS_OLLAMA_MODEL=gemma4:26b
MISSIONOS_OLLAMA_BASE_URL=http://localhost:11434

# Route-level LLM flags.
#
# Leave these enabled when selecting `gemini` or `ollama` so the chat path can
# use LLM-backed planning and repair. When MISSIONOS_LLM_BACKEND=off, the
# CLI-managed Gateway process forces them to 0 even though this template keeps
# the intended LLM route flags visible.
MISSIONOS_AGENT_RUNTIME_ADK_ENABLED=1
MISSIONOS_CHIEF_ROUTE_SEMANTIC_ADK_ENABLED=1
MISSIONOS_LLM_DIALOGUE_ROUTER_ADK_ENABLED=1
MISSIONOS_LLM_REPAIR_PLANNER_ADK_ENABLED=1
MISSIONOS_LLM_RESPONSE_PLANNER_ADK_ENABLED=1
MISSIONOS_REAL_HARDWARE_ARM_DISARM_PLANNER_ADK_ENABLED=1

# The outer Chief Agent wait is backend-aware. Defaults and hard caps are:
# - Gemini: 45 seconds by default, capped at 90 seconds
# - DeepSeek: 60 seconds by default, capped at 120 seconds
# - Ollama / MLX: 180 seconds by default, capped at 300 seconds
# Usually leave this unset. An explicit value is still bounded by the active
# Chief Agent backend's cap.
# MISSIONOS_AUTONOMY_CONVERSATION_AGENT_TIMEOUT_SECONDS=90

# Component-level calls have independent timeouts. Local models are often
# slower than hosted Gemini, so these example values target Gemma/Ollama on a
# workstation. Use lower values when intentionally configuring Gemini.
MISSIONOS_LLM_DIALOGUE_ROUTER_TIMEOUT_SECONDS=180
MISSIONOS_CHIEF_ROUTE_SEMANTIC_TIMEOUT_SECONDS=240
MISSIONOS_AGENT_RUNTIME_TIMEOUT_SECONDS=240
MISSIONOS_LLM_REPAIR_PLANNER_TIMEOUT_SECONDS=180
MISSIONOS_LLM_RESPONSE_PLANNER_TIMEOUT_SECONDS=180
MISSIONOS_REAL_HARDWARE_ARM_DISARM_PLANNER_TIMEOUT_SECONDS=180

# Intended hosted chat path:
# MISSIONOS_LLM_BACKEND=gemini
# GOOGLE_API_KEY=...

# Hosted DeepSeek chat path (requires `.[local-llm]` dependencies):
# MISSIONOS_LLM_BACKEND=deepseek
# DEEPSEEK_API_KEY=...
# MISSIONOS_DEEPSEEK_MODEL=deepseek-v4-flash

# Local chat path:
# MISSIONOS_LLM_BACKEND=ollama
# MISSIONOS_OLLAMA_MODEL=gemma4:26b

# Optional per-agent override:
# MISSIONOS_AGENT_MISSIONOS_RUNTIME_RECOVERY_AGENT_LLM_BACKEND=gemini
# MISSIONOS_AGENT_MISSIONOS_RUNTIME_RECOVERY_AGENT_MODEL_ID=gemini-3.1-flash-lite

# Optional per-process model override; the default above is the supported
# hosted model for MissionOS.

# Gateway authority boundary.
#
# With no key, MissionOS accepts only non-browser loopback clients; browser
# Origin requests and remote clients are rejected. Set a strong key before
# exposing the Gateway beyond the local CLI. Browser access additionally needs
# an exact comma-separated origin allowlist. The MissionOS CLI reads this key
# from the environment or the same `.env` file and sends it as `X-API-Key`.
GATEWAY_API_KEY=
GATEWAY_CORS_ALLOWED_ORIGINS=

# Legacy shell/tool, root-agent, memory, cron, and control-loop HTTP surfaces
# are outside the MissionOS control-plane boundary and stay hidden by default.
GATEWAY_LEGACY_AGENT_ROUTES_ENABLED=false
