+"""Independent plate-law checks for the finite nonlinear endpoint allocator."""
+from dataclasses import asdict, replace
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from src.runtime import starship_fin_allocation as fin, starship_sixdof as dyn, starship_physics as env
+from src.runtime.starship_sixdof_mission import _attitude, control, vehicle
+
+
+@pytest.fixture
+def configured():
+    profile = json.loads((Path(__file__).parents[2]/"examples/spaceflight/starship-sixdof-profile.json").read_text())
+    body = vehicle(profile, payload_count=15)
+    point = env.surface_state(25.9, -97.1, 63000., 100000., time_s=4200.)
+    up, east, north = env.local_frame(point)
+    axis = env.add(env.scale(east, math.cos(math.radians(70.))), env.scale(up, math.sin(math.radians(70.))))
+    state = dyn.State6DOF(point.time_s, point.r, env.add(point.v, env.scale(east, 3000.)),
+        _attitude(axis, env.scale(north, -1)), (.002, -.003, .001), 100000.,
+        tuple(dyn.EngineState() for _ in body.engines),
+        (0., 0., 0., *np.radians([49., -51., 52.5, -49.])))
+    return profile, body, state
+
+
+@pytest.mark.parametrize("angles", ([49., -51., 52.5, -49.], [-60., 60., -60., 60.], [0., 0., 0., 0.]))
+def test_frozen_map_matches_original_integrator_loads_and_derivatives(configured, angles):
+    _, body, state = configured
+    observed = dyn.observe(state, body)
+    model = fin.frozen_surface_model(body, observed, [3, 4, 5, 6])
+    values = np.radians(angles)
+    moment, jac = model(values, derivative=True)
+    physical = dyn.observe(replace(state, flap_angles_rad=(0., 0., 0., *values)), body)
+    assert moment == pytest.approx(physical["aero_torque_body_nm"], abs=1e-7, rel=1e-12)
+    for i in range(4):
+        lo, hi = values.copy(), values.copy()
+        lo[i] -= 1e-6
+        hi[i] += 1e-6
+        numeric = (model(hi)-model(lo))/2e-6
+        assert jac[:, i] == pytest.approx(numeric, rel=2e-7, abs=1e-3)
+    assert model(np.array([values, values])).shape == (2, 3)
+
+
+@pytest.mark.parametrize("demand", ([0., 0., 0.], [200000., -150000., 50000.], [1e7, -1e7, 1e7]))
+def test_nonlinear_prediction_improves_hold_and_linear_candidate_with_same_bounds(configured, demand):
+    profile, body, state = configured
+    before = asdict(state)
+    observed = dyn.observe(state, body)
+    _, _, receipt = fin.allocate_fins(state, body, demand, observed, profile, interval_s=.1,
+                                    policy_id=fin.NONLINEAR_POLICY_ID)
+    angles = np.array(receipt["predicted_endpoint_angles_rad"])
+    delta = angles-np.array(receipt["actual_angles_rad"])
+    assert np.all(delta >= np.array(receipt["reachable_delta_lower_rad"])-1e-12)
+    assert np.all(delta <= np.array(receipt["reachable_delta_upper_rad"])+1e-12)
+    physical = dyn.observe(replace(state, flap_angles_rad=(0., 0., 0., *angles)), body)
+    remaining = np.array(demand)-(np.array(physical["aero_torque_body_nm"])-observed["aero_torque_body_nm"])
+    cost = float(np.sum((remaining/receipt["moment_scale_nm"])**2))
+    assert cost == pytest.approx(receipt["objective"], abs=1e-12)
+    assert cost <= receipt["nonlinear_hold_objective"]+1e-12
+    assert cost <= receipt["nonlinear_linear_endpoint_objective"]+1e-12
+    assert np.all(np.diff(receipt["nonlinear_objective_history"]) < 0.)
+    assert receipt["nonlinear_iterations"] <= 8
+    assert asdict(state) == before
+    assert receipt["nonlinear_global_optimum_proven"] is False
+
+
+def test_nonlinear_commands_still_require_finite_physical_execution(configured):
+    profile, body, state = configured
+    command, diagnostic = control(state, body, state.q_body_to_eci, 0., 0, profile, use_flaps=True,
+        development_fin_allocation=True, development_fin_policy=fin.NONLINEAR_POLICY_ID)
+    receipt = diagnostic["development_fin_allocation"]
+    following = dyn.step(state, body, command, .1)
+    assert following.flap_angles_rad[3:] == pytest.approx(receipt["predicted_endpoint_angles_rad"], abs=1e-5)
+    assert following.r_eci_m != state.r_eci_m
+    assert following.propellant_kg < state.propellant_kg
+    assert all(not engine.enabled for engine in command.engines[:6])
