+def nonlinear_endpoint(model, desired, actual, linear, scale, lower, upper):
+    """Finite, deterministic multistart + safeguarded Gauss-Newton steps.
+
+    This is a local nonlinear solve, not a proof of a global optimum. Every
+    accepted step improves the true frozen-flow moment cost. Hold and the old
+    linear endpoint are included, so a worse prediction cannot replace either.
+    All starts and steps remain inside the physically reachable endpoint box.
+    """
+    corners = np.array(list(product(*zip(lower, upper))))
+    starts = np.vstack((actual, linear, (lower+upper)/2, corners))
+    errors = (model(starts)-desired)/scale
+    costs = np.sum(errors**2, axis=1)
+    angles = starts[int(np.argmin(costs))].copy()
+    history = [float(np.min(costs))]
+    for _ in range(8):
+        moment, jac = model(angles, derivative=True)
+        residual = (moment-desired)/scale
+        step = bounded_least_squares(jac/scale[:, None], -residual, lower-angles, upper-angles)
+        trials = np.clip(angles+np.array([1., .5, .25, .125, .0625, .03125, .015625, .0078125])[:, None]*step, lower, upper)
+        trial_costs = np.sum(((model(trials)-desired)/scale)**2, axis=1)
+        best = int(np.argmin(trial_costs))
+        if trial_costs[best] >= history[-1]-1e-14:
+            break
+        angles = trials[best]
+        history.append(float(trial_costs[best]))
+    moment, jac = model(angles, derivative=True)
+    gradient = (jac/scale[:, None]).T@((moment-desired)/scale)
+    return angles, gradient, {"allocation_priority": "bounded_nonlinear_endpoint_moment_error",
+        "nonlinear_hold_objective": float(costs[0]), "nonlinear_linear_endpoint_objective": float(costs[1]),
+        "nonlinear_seed_minimum_objective": float(np.min(costs)), "nonlinear_objective_history": history,
+        "nonlinear_iterations": len(history)-1, "maximum_nonlinear_iterations": 8,
+        "nonlinear_global_optimum_proven": False}
