        "radius_m": 125000.0
      },
      "west": {
        "latitude_deg": 5.0,
        "longitude_deg": 143.0,
        "radius_m": 125000.0
      }
    },
    "contact": {
      "maximum_speed_mps": 5.0,
      "maximum_tilt_deg": 5.0,
      "maximum_body_rate_rad_s": 0.02,
      "minimum_fuel_kg": 28000.0
    },
    "waiting": {
      "initial_energy_kwh": 22.0,
      "power_kw": 6.0,
      "minimum_energy_kwh": 12.0,
      "initial_temperature_k": 295.0,
      "warming_k_per_s": 0.001,
      "maximum_temperature_k": 310.0,
      "loss_upper_kg_per_s": 0.02
    },
    "uncertainty": {
      "method": "center_and_two_joint_perturbations_not_full_box_proof",
      "position_m": 3.0,
      "velocity_mps": 0.003,
      "attitude_deg": 0.01,
      "body_rate_rad_s": 2e-05,
      "fuel_kg": 100.0,
      "contact_footprint_padding_m": 20000.0,
      "contact_time_padding_s": 30.0
    },
    "fresh_state_match": {
      "position_m": 30.0,
      "velocity_mps": 0.05,
      "attitude_deg": 0.1,
      "body_rate_rad_s": 0.0002,
      "fuel_kg": 300.0,
      "maximum_sample_gap_s": 2.01
    },
    "assumptions": [
      "Perfect observed actuator position and health telemetry; bounded synthetic navigation and gauge errors.",
      "Energy, temperature and vent-loss bounds are accounting assumptions; no heat transfer, slosh, boil-off or electrical subsystem simulation.",
      "Region inclusion is geometric; ocean clearance, recovery vessels, weather validity and real spacecraft accuracy are not certified.",
      "The comparison campaign uses a synthetic 22 kWh initial energy budget and 6 kW waiting load to retain two feasible opportunities with a smaller next-orbit margin; these are not measured Starship values."
    ]
  },
  "comparison_preparation": {
    "schema": "missionos.return_comparison_preparation.v1",
    "initial_candidates": [
      "nominal"
    ],
    "update_candidates": [
      "nominal",
      "next_orbit"
    ],
    "material_notice_fields": [
      "areas",
      "expires_at_s",
      "text",
      "recovery_service_forecast"
    ],
    "reuse": "fresh_state_prediction_then_current_admission",
    "protect_booking": true,
    "minimum_start_budget_s": 180.0,
    "cost_time_basis": "candidate_return_time",
    "decision_quality_audit": "observed_interval_pareto_v1",
    "deep_reasoning": {
      "routing": "prepared_uncertain_material_update_once_per_generation",
      "thinking": "enabled",
      "maximum_output_tokens": 4096,
      "model": "deepseek-flash",
      "reasoning_effort": "high"
    },
    "quality_objectives": [
      "estimated_completion_time_s",
      "elapsed_wait_s",
      "energy_remaining_kwh",
      "temperature_upper_k",
      "reserve_after_loss_kg"
    ]
  },
  "observed_notice_values": {
    "initial_east_delay_after_contact_s": [
      450.0,
      1050.0
    ],
    "revised_east_delay_after_contact_s": [
      6600.0,
      9900.0
    ],
    "west_delay_after_contact_s": [
      900.0,
      2100.0
    ]
  },
  "evaluation_conditions": {
    "comparison_normal": {
      "notice_update_at_s": 1350.0,
      "material_update": false,
      "model_mode": "live",
      "synthetic_tool_failure": null,
      "persistent_model_timeout_after_update": false
    },
    "comparison_update": {
      "notice_update_at_s": 1350.0,
      "material_update": true,
      "model_mode": "live",
      "synthetic_tool_failure": null,
      "persistent_model_timeout_after_update": false
    },
    "comparison_late": {
      "notice_update_at_s": 2250.0,
      "material_update": true,
      "model_mode": "fixture",
      "synthetic_tool_failure": null,
      "persistent_model_timeout_after_update": false
    },
    "comparison_tool_failure": {
      "notice_update_at_s": 1350.0,
      "material_update": true,
      "model_mode": "fixture",
      "synthetic_tool_failure": "cancel_on_material_update",
      "persistent_model_timeout_after_update": false
    },
    "comparison_timeout": {
      "notice_update_at_s": 1350.0,
      "material_update": true,
      "model_mode": "fixture",
      "synthetic_tool_failure": null,
      "persistent_model_timeout_after_update": true
    }
  }
